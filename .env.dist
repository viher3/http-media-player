# Copy to .env and adjust: cp .env.dist .env

# Host folder with your audio/video files (mounted read-only at /media)
MEDIA_PATH=./media

# Host port where the app is exposed
PORT=8080

# Uncomment on network volumes (NFS/SMB) where file events are not delivered
# WATCH_POLLING=1

# Uncomment when running behind an HTTPS reverse proxy
# TRUST_PROXY=1
